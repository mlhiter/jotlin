generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @default(now()) @updatedAt
  messageLimit  Int        @default(200)
  role          UserRole   @default(USER)
  accounts      Account[]
  chats         Chat[]
  feedbacks     Feedback[]
  sessions      Session[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

model Chat {
  id        String     @id @default(cuid())
  title     String?
  userId    String
  parentId  String?
  phase     ChatPhase?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  isDeleted Boolean    @default(false)
  isPublic  Boolean    @default(false)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  mvp       Mvp?
  parent    Chat?      @relation("ProjectPhases", fields: [parentId], references: [id], onDelete: Cascade)
  children  Chat[]     @relation("ProjectPhases")
  documents Document[]

  @@map("chat")
}

model Message {
  id        String   @id @default(cuid())
  role      String
  chatId    String
  createdAt DateTime @default(now())
  metadata  Json?
  parts     Json
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("message")
}

model Mvp {
  id                  String   @id @default(cuid())
  chatId              String   @unique
  sandboxId           String?  @unique
  previewUrl          String?
  files               Json
  requirementSnapshot String
  status              String   @default("running")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  vercelDeploymentId  String?  @unique
  vercelUrl           String?
  chat                Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@index([sandboxId])
  @@index([vercelDeploymentId])
  @@map("mvp")
}

model Feedback {
  id        String       @id @default(cuid())
  type      FeedbackType
  title     String
  content   String
  email     String?
  userId    String?
  metadata  Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User?        @relation(fields: [userId], references: [id])

  @@map("feedback")
}

model Document {
  id           String         @id @default(cuid())
  chatId       String
  phase        ChatPhase
  content      String         @db.Text
  status       DocumentStatus @default(DRAFT)
  sourceChatId String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  chat         Chat           @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("document")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum FeedbackType {
  BUG_REPORT
  FEATURE_REQUEST
  GENERAL
  COMPLAINT
  COMPLIMENT
}

enum ChatPhase {
  REQUIREMENT
  ARCHITECTURE
  DEVELOPMENT
}

enum DocumentStatus {
  DRAFT
  COMPLETED
  ARCHIVED
}
