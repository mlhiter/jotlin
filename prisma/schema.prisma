generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(uuid())
  name          String
  email         String     @unique
  emailVerified Boolean    @default(true)
  image         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @default(now()) @updatedAt
  messageLimit  Int        @default(200)
  role          UserRole   @default(USER)
  accounts      Account[]
  chats         Chat[]
  feedbacks     Feedback[]

  @@map("user")
}

model Account {
  id                String   @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@map("account")
}

model Chat {
  id                   String               @id @default(cuid())
  title                String?
  userId               String
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  deletedAt            DateTime?
  isDeleted            Boolean              @default(false)
  isPublic             Boolean              @default(false)
  parentId             String?
  phase                ChatPhase?
  parent               Chat?                @relation("ProjectPhases", fields: [parentId], references: [id], onDelete: Cascade)
  children             Chat[]               @relation("ProjectPhases")
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages             Message[]
  competitorResearches CompetitorResearch[]

  @@map("chat")
}

model Message {
  id        String   @id @default(cuid())
  role      String
  chatId    String
  createdAt DateTime @default(now())
  metadata  Json?
  parts     Json
  order     Int      @default(0)
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@map("message")
}

model Feedback {
  id        String       @id @default(cuid())
  type      FeedbackType
  title     String
  content   String
  email     String?
  userId    String?
  metadata  Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User?        @relation(fields: [userId], references: [id])

  @@map("feedback")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum FeedbackType {
  BUG_REPORT
  FEATURE_REQUEST
  GENERAL
  COMPLAINT
  COMPLIMENT
}

enum ChatPhase {
  REQUIREMENT
}

model CompetitorResearch {
  id           String    @id @default(cuid())
  chatId       String
  phase        ChatPhase @default(REQUIREMENT)
  query        String
  results      Json
  analysis     Json?
  status       String    @default("pending")
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  chat         Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@index([chatId, phase])
  @@map("competitor_research")
}
